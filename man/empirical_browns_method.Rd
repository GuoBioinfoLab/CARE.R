% Generated by hand for the CARE.R package.
\name{empirical_browns_method}
\alias{empirical_browns_method}
\title{Empirical Brown's Method for combining dependent p-values}
\usage{
empirical_browns_method(
  data_matrix,
  p_values,
  min_reference_samples = 4,
  cap_at_fisher = TRUE
)
}
\arguments{
\item{data_matrix}{A numeric matrix with one row per p-value (e.g. per
hallmark) and one column per reference sample (e.g. ssGSEA scores across
control + treatment samples).}

\item{p_values}{A numeric vector of p-values, one per row of
\code{data_matrix}, in the same order.}

\item{min_reference_samples}{Minimum number of complete reference columns
required before the empirical covariance estimate is attempted.}

\item{cap_at_fisher}{If \code{TRUE}, the Brown degrees of freedom are
capped at Fisher's df (equivalent to scale factor 1) when the estimate
would exceed it.}
}
\value{
A list with components \code{P_Brown}, \code{P_Fisher},
\code{Fisher_statistic}, \code{Scale_Factor}, \code{DF_Brown},
\code{Brown_Variance}, \code{Covariance_Sum}, \code{Covariance_Matrix},
\code{Transformed_Data}, \code{Reference_N} and \code{Fallback}
(character reason when the Fisher fallback was used, otherwise \code{NA}).
}
\description{
Combines p-values from multiple hallmarks while accounting for their
correlation estimated empirically from a reference data matrix (Poole
et al. 2016). If the reference data is unsuitable (too few samples, zero
variance, non-finite covariance, ...), it falls back to Fisher's method.
}
\examples{
set.seed(1)
m <- matrix(rnorm(30), nrow = 3, ncol = 10)
p <- c(0.01, 0.04, 0.03)
empirical_browns_method(m, p)
}
