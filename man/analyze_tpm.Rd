% Generated by hand for the CARE.R package.
\name{analyze_tpm}
\alias{analyze_tpm}
\title{Analyze control vs treatment TPM matrices with cancer/aging hallmarks}
\usage{
analyze_tpm(
  control_path,
  treatment_path,
  gene_set_path = system.file("extdata", "cancer_aging_hallmark.json",
    package = "CARE.R")
)
}
\arguments{
\item{control_path}{Path to the control TPM matrix file (CSV or TSV,
first column = gene identifier, at least two sample columns).}

\item{treatment_path}{Path to the treatment TPM matrix file (same format
as \code{control_path}).}

\item{gene_set_path}{Path to the hallmark gene-set JSON file. Defaults to
the gene sets shipped with the package.}
}
\value{
A named list mirroring the CARE backend JSON output with components
\code{status}, \code{direction_consistent}, \code{pebm}, \code{fisher_p},
\code{fisher_statistic}, \code{brown_df}, \code{brown_scale},
\code{fallback}, \code{warnings}, \code{input_summary}, \code{hallmarks} and
\code{distribution}.
}
\description{
Packaged version of the CARE backend \file{analyze_tpm.R} script. Reads
and validates two genes-by-samples TPM matrices, restricts them to common
genes (>= 20), runs ssGSEA (\code{GSVA::gsva}, method = "ssgsea") on the
three cancer-aging hallmarks (genomic instability, epigenetic alterations,
chronic inflammation), computes per-hallmark median change and one-sided
Wilcoxon p-values (\code{alternative = "less"}), and, when all three
hallmarks decrease under treatment, combines the p-values with Empirical
Brown's Method into the evidence score \code{pebm}.
}
\examples{
\dontrun{
res <- analyze_tpm("control.csv", "treatment.csv")
res$pebm
res$hallmarks
}
}
